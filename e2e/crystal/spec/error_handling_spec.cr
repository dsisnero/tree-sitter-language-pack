      __result = TsPackCore.process("", TsPackCore::ProcessConfig.from_json("{\"language\":\"javascript\"}"))
      # TODO: unsupported assertion `not_error`
    end
    it "get_language with empty string returns an error" do
      expect_raises(Exception) do
