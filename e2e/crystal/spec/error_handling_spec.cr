    it "Detect language from empty content returns null" do
      __result = TsPackCore.detect_language_from_content("")
      # TODO: unsupported assertion `not_error`
      __result.to_s.should be_empty
    end
    it "Detect language from empty extension returns null" do
      __result = TsPackCore.detect_language_from_extension("")
      # TODO: unsupported assertion `not_error`
      __result.to_s.should be_empty
    end
